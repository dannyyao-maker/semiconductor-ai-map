    {
      "id": "ai-server",
      "name": "AI 伺服器",
      "nameEn": "AI Servers",
      "zone": "ai-hw",
      "order": 7,
      "status": "待查證",
      "oneLiner": "把 AI 晶片、記憶體、散熱、電源等零件組裝成整台、甚至整櫃的伺服器，賣給雲端業者和大型企業。",
      "analogy": "像組裝超級跑車的工廠：引擎（GPU）由別人供應，但要把引擎、底盤、冷卻系統組得又快又穩，還要能大量、準時交車。",
      "upstream": [
        {
          "node": "ai-chip",
          "text": "NVIDIA GPU，或雲端業者自研的 ASIC"
        },
        {
          "node": "memory",
          "text": "高頻寬記憶體等"
        },
        {
          "text": "散熱模組、電源供應器、機殼、網路線材等零組件"
        }
      ],
      "downstream": [
        {
          "node": "cloud",
          "text": "主要客戶是大型雲端業者"
        },
        {
          "node": "datacenter",
          "text": "伺服器最後裝進資料中心"
        },
        {
          "text": "政府（主權 AI）、大型企業自建 AI 機房"
        }
      ],
      "companies": [
        "foxconn",
        "quanta",
        "wistron",
        "wiwynn",
        "supermicro"
      ],
      "business": {
        "model": "台灣廠商多以 ODM（替客戶設計加製造）模式接單，賺組裝與系統整合的費用。產品從單台伺服器走向整櫃出貨，附加價值提高。",
        "margin": "營收規模很大，但毛利率低，通常只有個位數百分比到一成左右，靠規模和周轉速度賺錢。",
        "bargainingPower": "夾在中間：上游 GPU 高度集中在 NVIDIA，下游客戶是少數大型雲端業者，兩邊議價能力都強。廠商靠整合能力、交期和良率競爭。"
      },
      "issues": [
        {
          "text": "整櫃式 AI 伺服器組裝複雜，量產初期的良率和出貨速度是挑戰。",
          "status": "待查證",
          "asOf": "2026-11",
          "sources": []
        },
        {
          "text": "客戶集中在少數雲端業者，一家客戶縮減訂單就會明顯影響營收。",
          "status": "待查證",
          "asOf": "2026-11",
          "sources": []
        },
        {
          "text": "美國關稅政策推動廠商在美國、墨西哥設廠，增加成本與管理難度。",
          "status": "待查證",
          "asOf": "2026-11",
          "sources": []
        }
      ],
      "topics": [
        {
          "text": "液冷散熱：AI 伺服器耗電、發熱大，散熱方式從風冷轉向液冷。",
          "status": "待查證",
          "asOf": "2026-11",
          "sources": []
        },
        {
          "text": "雲端業者自研 ASIC 伺服器和 NVIDIA 伺服器的消長，影響代工廠的客戶組合。",
          "status": "待查證",
          "asOf": "2026-11",
          "sources": []
        },
        {
          "text": "各國主權 AI 與大型資料中心投資計畫，帶動新一波訂單。",
          "status": "待查證",
          "asOf": "2026-11",
          "sources": []
        }
      ],
      "reading": []
