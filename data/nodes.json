    {
      "id": "ic-design",
      "name": "IC 設計",
      "nameEn": "IC Design",
      "zone": "semi",
      "order": 2,
      "status": "待查證",
      "oneLiner": "只負責設計晶片、把製造外包給晶圓代工廠的公司，業界稱為 Fabless（無晶圓廠）。",
      "analogy": "像只做設計的服裝品牌：自己畫設計圖、經營品牌和客戶，衣服交給專業代工廠縫製，所以不用自己蓋工廠。",
      "upstream": [
        {
          "text": "EDA 設計軟體（例如 Synopsys、Cadence）和矽智財 IP 授權（例如 Arm），等於設計晶片用的工具和現成零件"
        },
        {
          "node": "foundry",
          "text": "把設計圖交給代工廠製造"
        },
        {
          "node": "packaging",
          "text": "做好的晶片再委託封測廠包裝、測試"
        }
      ],
      "downstream": [
        {
          "text": "手機、筆電、電視、網通設備、汽車等品牌與系統廠"
        },
        {
          "node": "ai-chip",
          "text": "部分 IC 設計公司也跨進 AI 晶片（客製化 ASIC）"
        }
      ],
      "companies": [
        "mediatek",
        "realtek",
        "novatek",
        "qualcomm",
        "broadcom"
      ],
      "business": {
        "model": "賣晶片賺錢。不用蓋工廠，資本支出低；主要成本是研發人才、晶圓代工費和光罩費。",
        "margin": "毛利率通常高於代工、組裝等環節，但每年要投入大量研發；技術領先、有獨家規格的產品利潤最好。",
        "bargainingPower": "對下游：有獨家規格時強，標準化產品容易陷入價格戰。對上游：先進製程產能集中在少數代工廠，議價能力偏弱。"
      },
      "issues": [
        {
          "text": "先進製程的代工價格持續上漲，如果無法轉嫁給客戶，毛利會被壓縮。",
          "status": "待查證",
          "asOf": "2026-11",
          "sources": []
        },
        {
          "text": "中國本土 IC 設計公司崛起，在中低階晶片市場帶來價格競爭。",
          "status": "待查證",
          "asOf": "2026-11",
          "sources": []
        },
        {
          "text": "手機、PC 市場成熟、成長放緩，公司需要找新的成長來源，例如 AI、車用。",
          "status": "待查證",
          "asOf": "2026-11",
          "sources": []
        }
      ],
      "topics": [
        {
          "text": "終端 AI（Edge AI）：讓手機、筆電直接在裝置上跑 AI，帶動新一代晶片換機需求。",
          "status": "待查證",
          "asOf": "2026-11",
          "sources": []
        },
        {
          "text": "傳統 IC 設計公司跨足客製化 AI 晶片（ASIC），爭取雲端業者的訂單。",
          "status": "待查證",
          "asOf": "2026-11",
          "sources": []
        },
        {
          "text": "美國出口管制改變中國市場的銷售機會，各家公司受影響程度不同。",
          "status": "待查證",
          "asOf": "2026-11",
          "sources": []
        }
      ],
      "reading": []
    },
    {
      "id": "foundry",
      "name": "晶圓代工",
      "nameEn": "Foundry",
      "zone": "semi",
      "order": 3,
      "status": "待查證",
      "oneLiner": "接受 IC 設計公司的訂單，用自己的工廠幫別人把晶片「做出來」，自己不賣品牌晶片。",
      "analogy": "像頂級的代工廚房：客戶給食譜（設計圖），廚房用最好的設備和穩定的手藝大量做出來，而且承諾不自己開餐廳跟客戶搶生意。",
      "upstream": [
        {
          "node": "equipment",
          "text": "向設備商買機台（例如 ASML 的曝光機），向材料商買矽晶圓、化學品"
        }
      ],
      "downstream": [
        {
          "node": "ic-design",
          "text": "主要客戶，把設計圖交來下單"
        },
        {
          "node": "ai-chip",
          "text": "近年成長最快的客戶群"
        },
        {
          "node": "packaging",
          "text": "做好的晶圓交給封測（台積電也自己做先進封裝）"
        }
      ],
      "companies": [
        "tsmc",
        "umc",
        "samsung",
        "intel",
        "smic"
      ],
      "business": {
        "model": "按晶圓片數收費，製程越先進、單價越高。屬於重資本產業，每年要投入巨額資本支出蓋廠、買設備；規模和良率（做出合格品的比例）決定能不能賺錢。",
        "margin": "差異很大：最先進製程的領先者毛利率很高；成熟製程供應者多，毛利較低，也比較受景氣循環影響。",
        "bargainingPower": "最先進製程幾乎由台積電主導，議價能力極強，有能力調漲價格；成熟製程競爭者多，議價能力弱。"
      },
      "issues": [
        {
          "text": "海外建廠（美國、日本、德國）的成本比台灣高，會稀釋毛利。",
          "status": "待查證",
          "asOf": "2026-11",
          "sources": []
        },
        {
          "text": "地緣政治與關稅：客戶要求分散生產地點，政府政策也影響投資決策。",
          "status": "待查證",
          "asOf": "2026-11",
          "sources": []
        },
        {
          "text": "成熟製程面臨中國廠商大舉擴產，價格競爭壓力上升。",
          "status": "待查證",
          "asOf": "2026-11",
          "sources": []
        }
      ],
      "topics": [
        {
          "text": "AI 晶片需求帶動最先進製程和先進封裝產能吃緊。",
          "status": "待查證",
          "asOf": "2026-11",
          "sources": []
        },
        {
          "text": "2 奈米世代量產，各家在最先進製程的競爭態勢。",
          "status": "待查證",
          "asOf": "2026-11",
          "sources": []
        },
        {
          "text": "英特爾晶圓代工業務的轉型與外部資金合作，以及三星的追趕進度。",
          "status": "待查證",
          "asOf": "2026-11",
          "sources": []
        }
      ],
      "reading": []
    },
